{
  "buildCommand": "pnpm --filter @kizuna/desktop build",
  "outputDirectory": "apps/desktop/dist",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/kizuna", "destination": "https://itsashn.github.io/kizuna/" },
    { "source": "/kizuna/:path*", "destination": "https://itsashn.github.io/kizuna/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
